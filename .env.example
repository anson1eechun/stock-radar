# 複製為 .env 後填入。沒填的功能會自動停用或改用替代方案。

# Discord：擇一設定。Bot 模式才有「我有進場」按鈕。
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# 雲端模型（仲裁、情境劇本）。沒填就全部改用本機模型。
# 官方金鑰（sk-ant-）或 OpenRouter 金鑰（sk-or-）皆可，網址與模型名稱在 config.yaml 的 llm.cloud 設定。
ANTHROPIC_API_KEY=

# 選填：提高 BLS API 每日額度（免費註冊 https://data.bls.gov/registrationEngine/）
BLS_API_KEY=

# 選填：事件歷史反應資料庫回補歷史首次公布值（免費註冊 https://fred.stlouisfed.org/docs/api/api_key.html）
FRED_API_KEY=
